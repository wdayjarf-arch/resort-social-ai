APP_NAME=Resort Social AI
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Aden

# Local compose defaults only. Change these before exposing anything beyond localhost.
POSTGRES_DB=resort_social
POSTGRES_USER=resort
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://resort:local-change-me@postgres:5432/resort_social
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# Generate a Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# JWT signing secret: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
INVITATION_TTL_HOURS=72

# Authentication is intentionally not exposed as a public login route in this foundation.
# Configure a trusted OIDC/session strategy before exposing tenant APIs.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
META_OAUTH_STATE_TTL_MINUTES=10

# AI stays in approval mode until resort facts and policies have been reviewed.
AI_AUTO_REPLY_ENABLED=false
AI_REQUIRE_HUMAN_APPROVAL=true
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONFIDENCE_THRESHOLD=0.88
AI_MIN_RETRIEVAL_SIMILARITY=0.68
AI_MAX_REPLY_CHARS=1800
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# Frontend build-time API URL. For local Compose use localhost; for remote deployment use HTTPS public API origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional CRM Google Contacts sync (OAuth refresh token with contacts scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRM_EXTRACTION_MODEL=gpt-4o-mini

# Outbound campaign delivery: set only channels you have approved/configured.
CAMPAIGN_MIN_INTERVAL_SECONDS=1.5
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_CAMPAIGN_PAGE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
